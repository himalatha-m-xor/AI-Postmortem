# ============================================
# LLM PROVIDER
# ============================================
LLM_PROVIDER=azure
LLM_MODEL=gpt-4o-mini

# ============================================
# AZURE OPENAI
# ============================================
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# ============================================
# DATABASE
# ============================================
POSTGRES_DB=aria_postmortem
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# SLACK INTEGRATION
# ============================================
SLACK_BOT_TOKEN=xoxb-your-slack-token-here
SLACK_INCIDENT_CHANNEL_ID=C0XXXXXXXXX
ENABLE_SLACK=true

# ============================================
# GITHUB INTEGRATION
# ============================================
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_ORG=your-org-name
GITHUB_REPO=your-repo-name
ENABLE_GITHUB=true

# ============================================
# AUTHENTICATION
# Email/Password authentication (no external OAuth needed)
# ============================================

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# FEATURE FLAGS
# ============================================
# Set to true for verbose SQL query logs and debug info
DEBUG_MODE=false
MAX_REQUESTS_PER_MINUTE=10
