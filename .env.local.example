# LLM Provider: 'openai' or 'azure'
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI API Key (for LLM_PROVIDER=openai)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Azure OpenAI Configuration (for LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Environment (development, production, staging)
NODE_ENV=development

# Application URL (for OAuth callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database URL (for production)
# Example: postgresql://user:password@localhost:5432/aria
DATABASE_URL=

# Enable debug logging (true/false)
DEBUG_MODE=true

# API Rate Limiting
MAX_REQUESTS_PER_MINUTE=10

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your-secret-key-here
