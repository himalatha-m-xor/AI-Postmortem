// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id                String   @id @default(cuid())
  title             String
  description       String?
  severity          String   // critical, high, medium, low
  status            String   // open, investigating, resolved
  startTime         DateTime
  endTime           DateTime?
  affectedServices  String[] // Array of service names
  usersImpacted     Int      @default(0)
  slackChannel      String?
  assignedTo        String?
  
  // Relationships
  postmortems       Postmortem[]
  slackMessages     SlackMessage[]
  logs              Log[]
  metrics           Metric[]
  alerts            Alert[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([status])
  @@index([severity])
  @@index([startTime])
}

model Postmortem {
  id                      String   @id @default(cuid())
  incidentId              String
  incident                Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  incidentTitle           String
  severity                String
  startTime               DateTime
  endTime                 DateTime
  durationMinutes         Int
  usersImpacted           Int
  servicesAffected        String[]
  estimatedRevenueLoss    String?
  
  executiveSummary        String
  rootCauseSummary        String
  rootCauseTechnicalDetails String?
  rootCauseCodeExample    String?
  
  contributingFactors     String[]
  whatWentWell            String[]
  whatWentPoorly          String[]
  remediationSteps        String[]
  
  // Relationships
  timeline                TimelineEvent[]
  preventionMeasures      PreventionMeasure[]
  actionItems             ActionItem[]
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  @@index([incidentId])
  @@index([createdAt])
}

model TimelineEvent {
  id            String     @id @default(cuid())
  postmortemId  String
  postmortem    Postmortem @relation(fields: [postmortemId], references: [id], onDelete: Cascade)
  
  timestamp     String
  event         String
  type          String     // detection, investigation, action, resolution
  user          String?
  
  @@index([postmortemId])
}

model PreventionMeasure {
  id            String     @id @default(cuid())
  postmortemId  String
  postmortem    Postmortem @relation(fields: [postmortemId], references: [id], onDelete: Cascade)
  
  category      String     // Monitoring, Testing, Process, Architecture
  action        String
  priority      String     // P0, P1, P2
  owner         String
  
  @@index([postmortemId])
}

model ActionItem {
  id            String     @id @default(cuid())
  postmortemId  String
  postmortem    Postmortem @relation(fields: [postmortemId], references: [id], onDelete: Cascade)
  
  task          String
  priority      String     // P0, P1, P2
  owner         String
  dueDate       String
  status        String     @default("pending") // pending, in_progress, completed
  
  @@index([postmortemId])
  @@index([status])
}

model SlackMessage {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  timestamp   String
  user        String
  message     String
  
  @@index([incidentId])
}

model Log {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  timestamp   String
  level       String   // error, warn, info, debug
  message     String
  service     String
  
  @@index([incidentId])
}

model Metric {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  timestamp   String
  metric      String
  value       Float
  unit        String?
  
  @@index([incidentId])
}

model Alert {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  timestamp   String
  type        String   // trigger, acknowledge, resolve
  message     String
  
  @@index([incidentId])
}
