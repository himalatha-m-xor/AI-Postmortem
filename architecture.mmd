graph TB
    subgraph Browser["User Interface"]
        UI1[Dashboard]
        UI2[Postmortem Viewer]
    end

    subgraph NextJS["Next.js Application"]
        subgraph Frontend["Frontend"]
            P1[page.tsx]
            P2[postmortems]
        end
        
        subgraph API["API Layer"]
            API1[POST /generate]
            API2[GET /generate]
        end
        
        subgraph Logic["Business Logic"]
            L1[AI Generator]
            L2[Prompt Builder]
            L3[Storage]
            L4[Rate Limiter]
        end
        
        subgraph Data["Data"]
            D1[Mock Incidents]
            D2[In-Memory]
        end
    end

    subgraph External["External Services"]
        AI[OpenAI GPT-4o-mini]
    end

    UI1 -->|Generate| P1
    P1 -->|POST| API1
    API1 -->|Validate| L4
    API1 -->|Fetch| D1
    API1 -->|Call| L1
    L1 -->|Build| L2
    L1 -->|Request| AI
    AI -->|JSON| L1
    L1 -->|Save| L3
    L3 -->|Store| D2
    API1 -->|Return| P1
    P1 -->|Navigate| P2
    P2 -->|GET| API2
    API2 -->|Fetch| D2
    UI2 -->|Display| P2

